# LaunchShield AI local development environment.
# Copy this file to .env and replace placeholders locally.
# Never commit real credentials. DATABASE_URL uses a URL-encoded password.

# SQLAlchemy URL: postgresql+psycopg://user:URL_ENCODED_PASSWORD@host:5432/database
DATABASE_URL=postgresql+psycopg://launchshield_user:URL_ENCODED_PASSWORD@localhost:5432/launchshield_ai

# Planned for future development; not currently consumed by the application.
REDIS_URL=
GEMINI_API_KEY=
